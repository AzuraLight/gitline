{
  "name": "gitline",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.7.0",
  "publisher": "AzuraLight",
  "author": {
    "name": "AzuraLight"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "l10n": "./l10n",
  "repository": {
    "type": "git",
    "url": "https://github.com/AzuraLight/gitline.git"
  },
  "homepage": "https://github.com/AzuraLight/gitline#readme",
  "bugs": {
    "url": "https://github.com/AzuraLight/gitline/issues"
  },
  "keywords": [
    "git",
    "git graph",
    "commit graph",
    "gitlens",
    "history",
    "branch",
    "log",
    "diff",
    "stash"
  ],
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "galleryBanner": {
    "color": "#3178c6",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.git/HEAD",
    "workspaceContains:**/.git/HEAD"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitline.openCommitGraph",
        "title": "%command.openCommitGraph.title%",
        "category": "Gitline",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitline.openFileHistory",
        "title": "%command.openFileHistory.title%",
        "category": "Gitline",
        "icon": "$(history)"
      },
      {
        "command": "gitline.pull",
        "title": "%command.pull.title%",
        "category": "Gitline",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitline.push",
        "title": "%command.push.title%",
        "category": "Gitline",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitline.fetchAll",
        "title": "%command.fetchAll.title%",
        "category": "Gitline",
        "icon": "$(sync)"
      },
      {
        "command": "gitline.toggleInlineBlame",
        "title": "%command.toggleInlineBlame.title%",
        "category": "Gitline"
      },
      {
        "command": "gitline.saveViewAsDefault",
        "title": "%command.saveViewAsDefault.title%",
        "category": "Gitline"
      },
      {
        "command": "gitline.openRepository",
        "title": "%command.openRepository.title%",
        "category": "Gitline"
      },
      {
        "command": "gitline.revealCommit",
        "title": "%command.revealCommit.title%",
        "category": "Gitline"
      },
      {
        "command": "gitline.openCommitPatch",
        "title": "%command.openCommitPatch.title%",
        "category": "Gitline"
      }
    ],
    "configuration": {
      "title": "Gitline",
      "properties": {
        "gitline.inlineBlame.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.inlineBlame.enabled%"
        },
        "gitline.graph.defaultView": {
          "type": "string",
          "enum": [
            "current",
            "all",
            "selected"
          ],
          "enumDescriptions": [
            "%config.graph.defaultView.current%",
            "%config.graph.defaultView.all%",
            "%config.graph.defaultView.selected%"
          ],
          "default": "current",
          "scope": "window",
          "markdownDescription": "%config.graph.defaultView%"
        },
        "gitline.repositories.searchDepth": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 8,
          "scope": "window",
          "markdownDescription": "%config.repositories.searchDepth%"
        },
        "gitline.repositories.ignoredFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules"
          ],
          "scope": "window",
          "markdownDescription": "%config.repositories.ignoredFolders%"
        },
        "gitline.graph.defaultBranches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "window",
          "markdownDescription": "%config.graph.defaultBranches%"
        },
        "gitline.graph.columns": {
          "type": "object",
          "properties": {
            "author": {
              "type": "boolean",
              "default": true,
              "description": "%config.graph.columns.author%"
            },
            "date": {
              "type": "boolean",
              "default": true,
              "description": "%config.graph.columns.date%"
            },
            "sha": {
              "type": "boolean",
              "default": true,
              "description": "%config.graph.columns.sha%"
            }
          },
          "additionalProperties": false,
          "default": {
            "author": true,
            "date": true,
            "sha": true
          },
          "scope": "window",
          "markdownDescription": "%config.graph.columns%"
        },
        "gitline.graph.dateFormat": {
          "type": "string",
          "enum": [
            "relative",
            "absolute"
          ],
          "enumDescriptions": [
            "%config.graph.dateFormat.relative%",
            "%config.graph.dateFormat.absolute%"
          ],
          "default": "relative",
          "scope": "window",
          "markdownDescription": "%config.graph.dateFormat%"
        },
        "gitline.graph.detailsLocation": {
          "type": "string",
          "enum": [
            "auto",
            "right",
            "bottom"
          ],
          "enumDescriptions": [
            "%config.graph.detailsLocation.auto%",
            "%config.graph.detailsLocation.right%",
            "%config.graph.detailsLocation.bottom%"
          ],
          "default": "auto",
          "scope": "window",
          "markdownDescription": "%config.graph.detailsLocation%"
        },
        "gitline.graph.highlightCurrentBranch": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "%config.graph.highlightCurrentBranch%"
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "gitlinePanel",
          "title": "%viewContainer.panel.title%",
          "icon": "$(git-branch)"
        }
      ]
    },
    "views": {
      "gitlinePanel": [
        {
          "type": "webview",
          "id": "gitline.panel",
          "name": "%view.panel.name%",
          "contextualTitle": "%view.panel.contextualTitle%",
          "icon": "$(git-branch)",
          "initialSize": 4,
          "visibility": "visible"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "gitline.openFileHistory",
          "group": "navigation@8",
          "when": "editorTextFocus && resourceScheme == file"
        }
      ],
      "explorer/context": [
        {
          "command": "gitline.openFileHistory",
          "when": "resourceScheme == file",
          "group": "gitline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gitline.revealCommit",
          "when": "false"
        },
        {
          "command": "gitline.openCommitPatch",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "compile:test": "tsc -p tsconfig.test.json",
    "test:unit": "npm run compile:test && mocha --ui bdd \"out-test/test/unit/**/*.test.js\"",
    "test:integration": "npm run compile && npm run compile:test && vscode-test --label stable",
    "test:integration:minimum": "npm run compile && npm run compile:test && vscode-test --label minimum",
    "test:integration:no-git-ext": "npm run compile && npm run compile:test && vscode-test --label no-git-ext",
    "test:integration:multi-repo": "npm run compile && npm run compile:test && vscode-test --label multi-repo",
    "test": "npm run test:unit && npm run test:integration",
    "package": "npm run compile && npx --yes @vscode/vsce@latest package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^10.8.2",
    "typescript": "^5.4.0"
  }
}
